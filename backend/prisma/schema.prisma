generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  operator
  viewer
}

enum DeviceType {
  access_point
  switch
  gateway
}

enum DeviceStatus {
  online
  offline
  warning
  maintenance
}

enum ManagementMode {
  central  // Managed via Aruba Central (config pulled from Central API)
  direct   // Managed directly on the local network (REST or SSH to the device)
}

enum AutomationType {
  configuration_backup
  firmware_update
  compliance_check
  custom_script
  monitoring_alert
}

enum AutomationCategory {
  network
  security
  monitoring
  maintenance
  compliance
}

enum AutomationPriority {
  low
  medium
  high
  critical
}

enum ExecutionStatus {
  pending
  running
  success
  failed
  cancelled
}

enum ApiCredentialType {
  switch
  ap
  gateway
  controller
  other
}

enum TestStatus {
  success
  failed
}

enum ScanStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum DiscoveredDeviceStatus {
  new
  imported
  ignored
}

enum BackupStatus {
  pending
  running
  success
  failed
}

enum BackupTrigger {
  manual
  scheduled
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  password      String
  name          String
  role          UserRole     @default(viewer)
  refreshToken  String?
  lastLogin     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  automations           Automation[]
  executions            Execution[]
  apiCredentials        ApiCredential[]
  arubaCentralConfigs   ArubaCentralConfig[]
}

model Device {
  id            String         @id @default(uuid())
  serial        String         @unique
  name          String
  type          DeviceType
  model         String
  ipAddress     String?
  macAddress    String?
  location      String?

  // ICMP Ping Monitoring Fields
  pingStatus        DeviceStatus?  // Real-time ping-based status (primary status)
  pingLastChecked   DateTime?      // Last time ping check was performed
  pingResponseTime  Int?           // Last successful ping response time in ms
  pingSuccessRate   Float?         // Success rate percentage (0-100)
  consecutiveFailures Int @default(0) // Count of consecutive ping failures

  // Aruba Central Status
  centralStatus     DeviceStatus   @default(offline) // Status from Aruba Central sync

  // How the platform reaches this device for config/polling. Devices synced from
  // Aruba Central are 'central'; manually-added and discovery-imported devices
  // default to 'direct' (reached over REST or SSH using linked credentials).
  managementMode    ManagementMode @default(direct)

  firmwareVersion String?
  lastSeen      DateTime?      // Last seen timestamp (updated by both ping monitoring and Aruba Central sync)
  metadata      Json?
  apiCredentialId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  apiCredential   ApiCredential? @relation("DeviceCredential", fields: [apiCredentialId], references: [id], onDelete: SetNull)
  executions      Execution[]
  deviceGroups    DeviceGroup[]

  @@index([apiCredentialId])
  @@index([pingStatus])
  @@index([pingLastChecked])
}

model DeviceGroup {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  devices     Device[]
  automations Automation[]
}

model Automation {
  id          String             @id @default(uuid())
  name        String
  description String?
  category    AutomationCategory
  priority    AutomationPriority
  active      Boolean            @default(false)
  enabled     Boolean            @default(true)
  elements    Json               // Stores Vue Flow nodes and edges (renamed from workflow)
  metadata    Json?              // Stores additional workflow metadata
  lastRun     DateTime?          // Timestamp of last execution
  createdBy   User               @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  
  schedules   Schedule[]
  executions  Execution[]
  deviceGroups DeviceGroup[]
}

model Schedule {
  id           String      @id @default(uuid())
  automation   Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String
  cronExpression String
  timezone     String      @default("UTC")
  active       Boolean     @default(true)
  nextRun      DateTime?
  lastRun      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  @@index([automationId])
  @@index([nextRun])
}

model Execution {
  id           String          @id @default(uuid())
  automation   Automation      @relation(fields: [automationId], references: [id])
  automationId String
  device       Device?         @relation(fields: [deviceId], references: [id])
  deviceId     String?
  status       ExecutionStatus @default(pending)
  startedAt    DateTime?
  completedAt  DateTime?
  duration     Int?            // Duration in milliseconds
  output       Json?
  error        String?
  triggeredBy  User?           @relation(fields: [userId], references: [id])
  userId       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  
  @@index([automationId])
  @@index([deviceId])
  @@index([status])
  @@index([startedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  userId    String
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model ApiCredential {
  id              String              @id @default(uuid())
  name            String
  type            ApiCredentialType
  username        String?
  password        String?             // Encrypted
  apiKey          String?             // Encrypted
  apiSecret       String?             // Encrypted
  notes           String?
  lastTested      DateTime?
  lastTestStatus  TestStatus?
  metadata        Json?
  createdBy       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  devices         Device[]            @relation("DeviceCredential")

  @@index([type])
  @@index([userId])
}

model DiscoveryScan {
  id            String      @id @default(uuid())
  status        ScanStatus  @default(pending)
  subnets       Json        // Array of CIDR strings scanned
  totalHosts    Int         @default(0)  // Hosts that responded to the sweep
  arubaHosts    Int         @default(0)  // Hosts matching Aruba/HPE OUIs or fingerprint
  progress      Int         @default(0)  // 0-100
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  triggeredBy   String?     // User id
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  discoveredDevices DiscoveredDevice[]

  @@index([status])
  @@index([createdAt])
}

model DiscoveredDevice {
  id              String                 @id @default(uuid())
  scan            DiscoveryScan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId          String
  ipAddress       String
  macAddress      String?
  vendor          String?                // OUI vendor name
  hostname        String?
  isArubaVendor   Boolean                @default(false)
  openPorts       Json?                  // Array of open ports found during fingerprinting
  suggestedType   DeviceType?            // Best-effort type detection
  suggestedName   String?
  centralSerial   String?                // Serial if matched in Aruba Central inventory
  centralMatch    Json?                  // Matched Central device summary (name, model, status)
  existingDeviceId String?               // Local Device.id if IP/MAC conflicts with inventory
  conflictType    String?                // ip_conflict | mac_conflict | central_managed | null
  status          DiscoveredDeviceStatus @default(new)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([scanId])
  @@index([status])
  @@index([macAddress])
}

model BackupSchedule {
  id              String    @id @default(uuid())
  name            String
  cronExpression  String
  timezone        String    @default("UTC")
  active          Boolean   @default(true)
  deviceSelection Json      // { mode: 'all' | 'types' | 'devices', types?: [], deviceIds?: [] }
  retentionDays   Int       @default(90)   // Prune backups older than this (0 = keep forever)
  retentionMaxCount Int     @default(30)   // Max backups kept per device (0 = unlimited)
  lastRun         DateTime?
  nextRun         DateTime?
  createdBy       String?   // User id
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  backups         ConfigBackup[]

  @@index([active])
}

model ConfigBackup {
  id            String        @id @default(uuid())
  deviceId      String
  deviceSerial  String
  deviceName    String        // Denormalized so history survives device deletion
  status        BackupStatus  @default(pending)
  trigger       BackupTrigger @default(manual)
  schedule      BackupSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleId    String?
  filePath      String?       // Path on local backup storage
  checksum      String?       // SHA-256 of config content
  sizeBytes     Int?
  hasChanges    Boolean?      // Differs from previous successful backup of this device
  error         String?
  triggeredBy   String?       // User id (manual runs)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([deviceId, createdAt])
  @@index([deviceSerial])
  @@index([status])
  @@index([scheduleId])
}

model ArubaCentralConfig {
  id              String    @id @default(uuid())
  baseUrl         String    // Aruba Central API base URL
  clientId        String    // OAuth2 Client ID
  clientSecret    String    // Encrypted OAuth2 Client Secret
  customerId      String    // Aruba Central Customer ID
  isActive        Boolean   @default(true)  // Allow multiple configs, but only one active
  lastTested      DateTime?
  lastTestStatus  TestStatus?
  notes           String?
  createdBy       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([isActive])
}
