generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  operator
  viewer
}

enum DeviceType {
  access_point
  switch
  gateway
  controller
  other
}

// Device manufacturer. Coarse and stable on purpose — OS/platform families
// (aos-cx, junos, ios-xe, ...) live in Device.platform as a validated string
// because they churn faster than vendors do.
enum Vendor {
  aruba
  juniper
  cisco
  other
}

// Cloud management planes we can integrate with. Each CloudIntegration row is
// one tenant/org of one of these; multiple rows per provider are allowed
// (e.g. two Central accounts and a Mist org side by side).
enum CloudProviderType {
  aruba_central
  juniper_mist
  cisco_meraki
}

enum DeviceStatus {
  online
  offline
  warning
  maintenance
}

enum ManagementMode {
  cloud   // Managed via a cloud platform (see Device.cloudIntegration for which one)
  direct  // Managed directly on the local network (REST or SSH to the device)
}

enum AutomationType {
  configuration_backup
  firmware_update
  compliance_check
  custom_script
  monitoring_alert
}

enum AutomationCategory {
  network
  security
  monitoring
  maintenance
  compliance
}

enum AutomationPriority {
  low
  medium
  high
  critical
}

enum ExecutionStatus {
  pending
  running
  success
  failed
  cancelled
}

enum ApiCredentialType {
  switch
  ap
  gateway
  controller
  other
}

enum TestStatus {
  success
  failed
}

enum ScanStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum DiscoveredDeviceStatus {
  new
  imported
  ignored
}

enum BackupStatus {
  pending
  running
  success
  failed
}

enum BackupTrigger {
  manual
  scheduled
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  password      String
  name          String
  role          UserRole     @default(viewer)
  refreshToken  String?
  lastLogin     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  automations           Automation[]
  executions            Execution[]
  apiCredentials        ApiCredential[]
  arubaCentralConfigs   ArubaCentralConfig[]
  cloudIntegrations     CloudIntegration[]
  gitBackupConfigs      GitBackupConfig[]
}

model Device {
  id            String         @id @default(uuid())
  serial        String?        @unique // optional: direct devices may have none (see utils/device-key.js)
  name          String
  type          DeviceType
  vendor        Vendor         @default(aruba)
  // OS/platform family: 'aos-cx' | 'aos-s' | 'junos' | 'ios-xe' | 'meraki'.
  // null = unknown/never classified (legacy rows keep pre-vendor default behavior).
  // Valid values per vendor are defined in src/constants/vendors.js.
  platform      String?
  model         String
  ipAddress     String?
  macAddress    String?
  location      String?

  // ICMP Ping Monitoring Fields
  pingStatus        DeviceStatus?  // Real-time ping-based status (primary status)
  pingLastChecked   DateTime?      // Last time ping check was performed
  pingResponseTime  Int?           // Last successful ping response time in ms
  pingSuccessRate   Float?         // Success rate percentage (0-100)
  consecutiveFailures Int @default(0) // Count of consecutive ping failures

  // Status as reported by the device's cloud management plane (Central/Mist/...)
  cloudStatus       DeviceStatus   @default(offline)

  // How the platform reaches this device for config/polling. Devices synced from
  // a cloud integration are 'cloud'; manually-added and discovery-imported devices
  // default to 'direct' (reached over REST or SSH using linked credentials).
  managementMode    ManagementMode @default(direct)

  // Which cloud plane manages/inventoried this device. Required in practice for
  // cloud-managed devices (multiple integrations may be active simultaneously,
  // including several tenants of the same provider); null for direct devices.
  cloudIntegration   CloudIntegration? @relation(fields: [cloudIntegrationId], references: [id], onDelete: SetNull)
  cloudIntegrationId String?

  // The device's OWN report of whether its cloud plane owns its configuration
  // (e.g. probed from the AOS-CX `system/aruba_central` REST resource). Independent
  // of managementMode, which only records how the record entered our inventory.
  // null = never probed / not determinable. See docs/CENTRAL_MANAGEMENT_MODE_PLAN.md.
  cloudManaged          Boolean?
  cloudConnectionStatus String?   // connected | not_reachable | connection_failure | disabled | unknown
  cloudManagedSource    String?   // switch-rest | central-group | manual (probe source, vocabulary unchanged from 5b)
  cloudManagedCheckedAt DateTime?

  // Always-on live state watch (services/live/state-monitor.service.js):
  // port link/PoE changes become DeviceEvent rows. Read-only, so it is allowed
  // on cloud-managed devices too when they have an IP and a device credential.
  liveMonitoring Boolean       @default(false)

  firmwareVersion String?
  lastSeen      DateTime?      // Last seen timestamp (updated by both ping monitoring and Aruba Central sync)
  metadata      Json?
  apiCredentialId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  apiCredential   ApiCredential? @relation("DeviceCredential", fields: [apiCredentialId], references: [id], onDelete: SetNull)
  executions      Execution[]
  deviceGroups    DeviceGroup[]
  events          DeviceEvent[]
  links           DeviceLink[]
  topologyState   DeviceTopologyState?
  topologyChanges TopologyChange[]

  @@index([apiCredentialId])
  @@index([cloudIntegrationId])
  @@index([pingStatus])
  @@index([pingLastChecked])
}

// A change observed on a device by the live state monitor: port.link.up|down,
// port.admin.up|down, port.poe.up|down|fault, monitor.connected|disconnected.
// Raw transitions, not debounced. Pruned after DEVICE_EVENT_RETENTION_DAYS.
model DeviceEvent {
  id         String   @id @default(uuid())
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId   String
  type       String
  port       String?
  data       Json     @default("{}")
  source     String   // push | poll | resync
  occurredAt DateTime @default(now())

  @@index([deviceId, occurredAt])
  @@index([type])
  @@index([occurredAt])
}

// A neighbor one device reports on one of its ports (LLDP or CDP), as of the
// last successful topology collection (services/topology/). The far end is
// resolved to a Device or DiscoveredDevice when the graph is built, not stored,
// so a device imported later links up without a recollection.
model DeviceLink {
  id                 String   @id @default(uuid())
  device             Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId           String
  localPort          String
  remoteChassisId    String   // as the neighbor advertised it (MAC, IP or name)
  remotePortId       String
  remoteSysName      String?
  remoteSysDesc      String?
  remotePortDesc     String?
  remoteMgmtIp       String?
  remoteMac          String?  // normalized MAC: the chassis id when it is one, else the port MAC
  remoteCapabilities Json     @default("[]") // normalized: bridge | router | wlan-ap | telephone | station | ...
  source             String   // lldp | cdp | cloud
  active             Boolean  @default(true) // false once a successful collection no longer sees it
  firstSeen          DateTime @default(now())
  lastSeen           DateTime @default(now())

  @@unique([deviceId, localPort, remoteChassisId, remotePortId])
  @@index([deviceId, active])
  @@index([remoteMac])
}

// Per-device topology collection status, plus the device's own LLDP identity
// so the far end's view of it can be matched back to this row.
model DeviceTopologyState {
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId      String    @id
  status        String    // ok | skipped (needs IP/credential) | unsupported (no source for the platform) | failed
  reason        String?   // why it was skipped, unsupported or failed
  source        String?   // transport that answered: AOS-CX REST, Junos NETCONF, SSH
  chassisId     String?   // normalized MAC, when the device advertises one
  sysName       String?
  neighborCount Int       @default(0)
  collectedAt   DateTime  @default(now())
  lastSuccessAt DateTime?
}

// A link appearing, disappearing or changing between collections. Pruned after
// TOPOLOGY_CHANGE_RETENTION_DAYS. Not written for a device's first collection.
model TopologyChange {
  id         String   @id @default(uuid())
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId   String
  type       String   // link.added | link.removed | link.changed
  localPort  String?
  data       Json     @default("{}")
  occurredAt DateTime @default(now())

  @@index([deviceId, occurredAt])
  @@index([occurredAt])
}

// Saved node positions for the Network Map, shared by everyone. scope is "all"
// or "site:<location>". updatedBy is a plain user id (no relation), so
// deleting a user leaves layouts alone.
model MapLayout {
  scope     String   @id
  positions Json     @default("{}") // { "<nodeKey>": { "x": 0, "y": 0 } }
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model DeviceGroup {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  devices     Device[]
  automations Automation[]
}

model Automation {
  id          String             @id @default(uuid())
  name        String
  description String?
  category    AutomationCategory
  priority    AutomationPriority
  active      Boolean            @default(false)
  enabled     Boolean            @default(true)
  elements    Json               // Stores Vue Flow nodes and edges (renamed from workflow)
  metadata    Json?              // Stores additional workflow metadata
  lastRun     DateTime?          // Timestamp of last execution
  createdBy   User               @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  
  schedules   Schedule[]
  executions  Execution[]
  deviceGroups DeviceGroup[]
}

model Schedule {
  id           String      @id @default(uuid())
  automation   Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String
  cronExpression String
  timezone     String      @default("UTC")
  active       Boolean     @default(true)
  nextRun      DateTime?
  lastRun      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  @@index([automationId])
  @@index([nextRun])
}

model Execution {
  id           String          @id @default(uuid())
  automation   Automation      @relation(fields: [automationId], references: [id])
  automationId String
  device       Device?         @relation(fields: [deviceId], references: [id])
  deviceId     String?
  status       ExecutionStatus @default(pending)
  startedAt    DateTime?
  completedAt  DateTime?
  duration     Int?            // Duration in milliseconds
  output       Json?
  error        String?
  triggeredBy  User?           @relation(fields: [userId], references: [id])
  userId       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  
  @@index([automationId])
  @@index([deviceId])
  @@index([status])
  @@index([startedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  userId    String
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model ApiCredential {
  id              String              @id @default(uuid())
  name            String
  type            ApiCredentialType
  username        String?
  password        String?             // Encrypted
  apiKey          String?             // Encrypted
  apiSecret       String?             // Encrypted
  notes           String?
  lastTested      DateTime?
  lastTestStatus  TestStatus?
  metadata        Json?
  createdBy       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  devices         Device[]            @relation("DeviceCredential")

  @@index([type])
  @@index([userId])
}

model DiscoveryScan {
  id            String      @id @default(uuid())
  status        ScanStatus  @default(pending)
  subnets       Json        // Array of CIDR strings scanned
  totalHosts    Int         @default(0)  // Hosts that responded to the sweep
  arubaHosts    Int         @default(0)  // Hosts matching Aruba/HPE OUIs or fingerprint
  progress      Int         @default(0)  // 0-100
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  triggeredBy   String?     // User id
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  discoveredDevices DiscoveredDevice[]

  @@index([status])
  @@index([createdAt])
}

model DiscoveredDevice {
  id              String                 @id @default(uuid())
  scan            DiscoveryScan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId          String
  ipAddress       String
  subnet          String?                // CIDR of the sweep that found it (null on older scans)
  macAddress      String?
  vendor          String?                // OUI vendor name
  hostname        String?
  isArubaVendor   Boolean                @default(false)
  openPorts       Json?                  // Array of open ports found during fingerprinting
  suggestedType   DeviceType?            // Best-effort type detection
  suggestedName   String?
  centralSerial   String?                // Serial if matched in Aruba Central inventory
  centralMatch    Json?                  // Matched Central device summary (name, model, status)
  existingDeviceId String?               // Local Device.id if IP/MAC conflicts with inventory
  conflictType    String?                // ip_conflict | mac_conflict | central_managed | null
  status          DiscoveredDeviceStatus @default(new)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([scanId])
  @@index([status])
  @@index([macAddress])
}

model BackupSchedule {
  id              String    @id @default(uuid())
  name            String
  cronExpression  String
  timezone        String    @default("UTC")
  active          Boolean   @default(true)
  deviceSelection Json      // { mode: 'all' | 'types' | 'devices', types?: [], deviceIds?: [] }
  retentionDays   Int       @default(90)   // Prune backups older than this (0 = keep forever)
  retentionMaxCount Int     @default(30)   // Max backups kept per device (0 = unlimited)
  includeScopes   Boolean   @default(false) // Also back up cloud scopes (Mist org/sites, ...)
  lastRun         DateTime?
  nextRun         DateTime?
  createdBy       String?   // User id
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  backups         ConfigBackup[]

  @@index([active])
}

model ConfigBackup {
  id            String        @id @default(uuid())
  deviceId      String
  deviceSerial  String
  deviceName    String        // Denormalized so history survives device deletion
  status        BackupStatus  @default(pending)
  trigger       BackupTrigger @default(manual)
  schedule      BackupSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleId    String?
  filePath      String?       // Path on local backup storage
  checksum      String?       // SHA-256 of config content
  sizeBytes     Int?
  hasChanges    Boolean?      // Differs from previous successful backup of this device
  commitSha     String?       // Git commit holding this config, when the Git mirror is enabled
  format        String?       // 'cli-text' | 'junos-set' | 'aoscx-json' | 'mist-config-json' | ...
  error         String?
  triggeredBy   String?       // User id (manual runs)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // One row per captured representation. filePath/checksum/format/sizeBytes
  // above mirror the primary artifact (CLI when there is one), so older
  // readers and pre-artifact rows keep working.
  artifacts     ConfigBackupArtifact[]

  @@index([deviceId, createdAt])
  @@index([deviceSerial])
  @@index([status])
  @@index([scheduleId])
}

// One representation of a backup's configuration. AOS-CX yields two: the CLI
// text a person can paste back, and the REST JSON config database.
model ConfigBackupArtifact {
  id        String       @id @default(uuid())
  backup    ConfigBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)
  backupId  String
  kind      String       // 'cli' | 'structured'
  format    String       // 'cli-text' | 'junos-set' | 'aoscx-json' | 'mist-config-json' | ...
  filePath  String
  checksum  String       // SHA-256 of this artifact's content
  sizeBytes Int
  createdAt DateTime     @default(now())

  @@unique([backupId, kind])
}

// Configuration held by a cloud plane above the device: a Mist org or site,
// a Central group. This is where AP configuration lives. integrationId is a
// plain column (no FK) and the names are denormalized, so history survives
// deleting the integration, the same way ConfigBackup outlives its device.
model ScopeBackup {
  id              String            @id @default(uuid())
  integrationId   String
  integrationName String
  provider        CloudProviderType
  scopeType       String            // 'org' | 'site' | 'group'
  scopeId         String
  scopeName       String
  status          BackupStatus      @default(pending)
  trigger         BackupTrigger     @default(manual)
  scheduleId      String?
  filePath        String?
  checksum        String?
  sizeBytes       Int?
  hasChanges      Boolean?
  format          String?           // 'mist-scope-json' | ...
  commitSha       String?
  error           String?
  triggeredBy     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([integrationId, scopeType, scopeId, createdAt])
  @@index([status])
}

// One configured cloud tenant/org (a Central account, a Mist org, a Meraki org).
// Multiple rows may be active at once, including several of the same provider;
// devices point at their owning row via Device.cloudIntegrationId.
model CloudIntegration {
  id             String            @id @default(uuid())
  provider       CloudProviderType
  name           String            // User label, e.g. "Prod Central" / "EU Mist Org"
  baseUrl        String            // API base URL (provider- and region-specific)
  // Provider-specific credential blob; secret values are field-encrypted before
  // persist (see settings.service). Shapes:
  //   aruba_central: { clientId, clientSecret*, customerId }
  //   juniper_mist:  { apiToken*, orgId }
  //   cisco_meraki:  { apiKey*, orgId }
  // (* = encrypted)
  credentials    Json
  isActive       Boolean           @default(true)
  lastTested     DateTime?
  lastTestStatus TestStatus?
  notes          String?
  createdBy      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  devices        Device[]

  @@index([provider, isActive])
  @@index([userId])
}

// Git mirror for configuration backups. A single active row configures the
// repository that config-backup.service commits each captured config into.
// The flat-file store (BACKUP_STORAGE_PATH / ConfigBackup.filePath) remains
// authoritative; Git is an additive mirror that preserves full history even
// after retention prunes the rows and files.
model GitBackupConfig {
  id             String      @id @default(uuid())
  name           String      @default("Config Backup Repository")
  repoPath       String      // Local repo dir; defaults to ./storage/config-repo
  remoteUrl      String?     // Optional push target; no remote = local history only
  branch         String      @default("main")
  authorName     String      @default("NetHelper")
  authorEmail    String      @default("nethelper@localhost")
  // Secret values are field-encrypted before persist (see settings.service).
  // Shape: { sshKeyPath, token* }   (* = encrypted)
  credentials    Json        @default("{}")
  isActive       Boolean     @default(false)
  lastTested     DateTime?
  lastTestStatus TestStatus?
  lastPush       DateTime?
  lastPushError  String?
  notes          String?
  createdBy      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([isActive])
  @@index([userId])
}

// DEPRECATED (Phase 0 multi-vendor): superseded by CloudIntegration. Rows were
// copied into CloudIntegration by the multi_vendor_phase0 migration; this table
// is kept for one release so a rollback path exists, then will be dropped.
model ArubaCentralConfig {
  id              String    @id @default(uuid())
  baseUrl         String    // Aruba Central API base URL
  clientId        String    // OAuth2 Client ID
  clientSecret    String    // Encrypted OAuth2 Client Secret
  customerId      String    // Aruba Central Customer ID
  isActive        Boolean   @default(true)  // Allow multiple configs, but only one active
  lastTested      DateTime?
  lastTestStatus  TestStatus?
  notes           String?
  createdBy       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([isActive])
}
