{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", {
      "args": "after-used",
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "caughtErrors": "none"
    }],
    "no-console": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-process-exit": "off",
    "eqeqeq": ["warn", "smart"],
    "prefer-const": "warn",
    "no-var": "error"
  }
}
