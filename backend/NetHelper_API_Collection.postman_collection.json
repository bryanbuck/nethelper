  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string",
      "description": "Base API URL"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "JWT Access Token"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string",
      "description": "JWT Refresh Token"
    }
  ],
