# Server Configuration
NODE_ENV=development
PORT=3000
# Listen address. 127.0.0.1 when nginx runs on the same host, so the API
# can't be reached around it.
BIND_ADDRESS=0.0.0.0
API_PREFIX=/api/v1

# Database Configuration
DATABASE_URL="postgresql://nethelper:password@localhost:5432/nethelper?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Secrets: REQUIRED. Validated at startup (src/config/env.js). In production the
# server refuses to start if any is missing, shorter than 32 characters, still
# a placeholder like the values below, or if the two JWT secrets are equal.
# Generate each with:  openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

# Encrypts stored device/cloud/git credentials. There is no fallback key.
# Changing it makes stored secrets unreadable unless you migrate them:
#   OLD_ENCRYPTION_KEY='<old>' npm run key:rotate
# (data written while this was unset: npm run key:rotate -- --from-legacy-default)
ENCRYPTION_KEY=your-super-secret-encryption-key-minimum-32-characters

# Aruba Central API Configuration
ARUBA_CENTRAL_BASE_URL=https://apigw-prod2.central.arubanetworks.com
ARUBA_CENTRAL_CLIENT_ID=your-client-id
ARUBA_CENTRAL_CLIENT_SECRET=your-client-secret
ARUBA_CENTRAL_CUSTOMER_ID=your-customer-id
ARUBA_CENTRAL_REDIRECT_URI=http://localhost:3000/api/v1/auth/aruba/callback

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=nethelper@example.com

# Browser origins allowed to call the API and open the WebSocket (comma-separated).
# Not needed when nginx serves the SPA on the same origin as the API. In
# development, localhost / private-LAN / *.local origins are always allowed.
CORS_ORIGINS=
# FRONTEND_URL is still honoured as one more allowed origin (legacy).
FRONTEND_URL=

# Set when running behind a reverse proxy so client IPs are real:
# "true", a hop count (e.g. 1), or an Express trust-proxy value like "loopback".
TRUST_PROXY=

# Maximum request body size
BODY_LIMIT=2mb

# Rate Limiting (window in minutes). AUTH_RATE_LIMIT_MAX caps *failed*
# login/refresh attempts per IP per window.
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=10

# Logging Configuration
LOG_LEVEL=info
# Log files (error.log, combined.log, services-*.log) rotate at 10 MB, 5 kept.
# Set LOG_FILES=false to log to stdout only (containers). In production,
# stdout is JSON either way.
LOG_FILES=true
LOG_DIR=./logs

# Service-specific log levels (optional)
# Format: SERVICE1:level,SERVICE2:level (e.g., "ARUBA_CENTRAL:debug,AUTH:warn,DEVICE:info")
SERVICE_LOG_LEVELS=

# Enable/disable specific services for logging (optional)
# Format: comma-separated service names (e.g., "ARUBA_CENTRAL,AUTH,DEVICE")
# Leave empty to enable all services
DEBUG_SERVICES=

# Ping Monitoring Configuration
PING_MONITOR_ENABLED=true
PING_MONITOR_INTERVAL=60000
PING_MONITOR_TIMEOUT=5
PING_MONITOR_BATCH_SIZE=20
PING_MONITOR_FAILURE_THRESHOLD=3

# Device Discovery
DISCOVERY_SCAN_TIMEOUT=300000

# Configuration Backups
BACKUP_STORAGE_PATH=./storage/config-backups
# Default Git mirror repository path, used when the in-app setting is blank
BACKUP_GIT_REPO_PATH=./storage/config-repo
# The optional Git mirror for backups is configured in the app, not here:
# Settings -> Credentials -> "Configuration Backup Git Mirror" (admin only).
# It needs the `git` binary on this host. Override the command timeout if a
# slow remote needs longer than 60s:
# BACKUP_GIT_TIMEOUT_MS=60000

# Direct-Device SSH (for non-Central, non-CX devices like AOS-S)
SSH_PORT=22
SSH_CONNECT_TIMEOUT=15000
SSH_COMMAND_TIMEOUT=45000
