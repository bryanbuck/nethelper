{
  "name": "nethelper-backend",
  "version": "0.9.0-beta.5",
  "description": "NetHelper API: multi-vendor network inventory, monitoring, and config backup",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "user:manage": "node scripts/user-manager.js",
    "setup": "npm install && npm run db:generate && npm run db:migrate",
    "key:rotate": "node scripts/rotate-encryption-key.js",
    "ci": "npm run lint && npm test",
    "postman:generate": "node scripts/generate-postman.js"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.5",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.2",
    "diff": "^9.0.0",
    "dotenv": "^18.0.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1",
    "ping": "^1.0.0",
    "prisma": "^5.7.0",
    "redis": "^4.6.11",
    "socket.io": "^4.8.4",
    "ssh2": "^1.17.0",
    "winston": "^3.19.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "clearMocks": true
  },
  "overrides": {
    "bull": {
      "uuid": "^11.1.1"
    }
  }
}
