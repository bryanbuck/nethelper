{
  "name": "aruba-nethelper-backend",
  "version": "1.0.0",
  "description": "Backend for Aruba Central Automation Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node scripts/seed-data.js",
    "setup": "npm install && npm run db:generate && npm run db:migrate"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "axios": "^1.6.2",
    "@prisma/client": "^5.7.0",
    "redis": "^4.6.11",
    "bull": "^4.11.5",
    "socket.io": "^4.6.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "prisma": "^5.7.0",
    "@faker-js/faker": "^8.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
