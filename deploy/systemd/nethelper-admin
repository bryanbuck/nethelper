#!/bin/sh
# NetHelper bare-metal admin helper. Runs the backend's admin scripts as the
# service user with /etc/nethelper/backend.env loaded, and writes that file.
#
# Install (as root):
#   ln -s /opt/nethelper/deploy/systemd/nethelper-admin /usr/local/sbin/nethelper-admin
#
#   nethelper-admin init-env
#   nethelper-admin users                       # interactive user menu
#   nethelper-admin users create-admin --email you@example.com --name "Your Name"
#   OLD_ENCRYPTION_KEY='<old key>' nethelper-admin rotate-key [--dry-run]
#   nethelper-admin restore /var/lib/nethelper/app-backups/<archive> [--dry-run]
#   nethelper-admin upgrade [--version VERSION] [--no-backup] [--yes]
#
# Paths follow deploy/README.md; override with NETHELPER_HOME (code),
# NETHELPER_ENV (settings file) and NETHELPER_USER (service user).

set -eu

NETHELPER_HOME=${NETHELPER_HOME:-/opt/nethelper}
NETHELPER_ENV=${NETHELPER_ENV:-/etc/nethelper/backend.env}
NETHELPER_USER=${NETHELPER_USER:-nethelper}

usage() {
  cat <<EOF
Usage: nethelper-admin <command> [args]

  init-env              Write $NETHELPER_ENV from the template, with generated
                        secrets and database/Redis passwords. Never overwrites.
  users [args]          User admin (backend/scripts/user-manager.js). No args:
                        interactive menu. "users create-admin --email E --name N"
                        creates the first admin; its password comes from
                        NETHELPER_ADMIN_PASSWORD, else one is generated and printed.
  rotate-key [--dry-run]
                        Re-encrypt stored secrets after changing ENCRYPTION_KEY,
                        with the old key in OLD_ENCRYPTION_KEY. Stop the backend first.
  restore <archive> [--dry-run] [--yes] [--force] [--key-out FILE]
                        Restore an application backup (Settings -> App Backup).
                        Stops nethelper-backend while it runs (not for --dry-run
                        or --key-out) and starts it again. An encrypted archive's
                        passphrase comes from NETHELPER_BACKUP_PASSPHRASE, else
                        a prompt. The archive must be readable by $NETHELPER_USER.
  upgrade [--version VERSION] [--no-backup] [--yes]
                        Upgrade an install from a release tarball to the newest
                        release (or VERSION): download and check it next to
                        $NETHELPER_HOME, install its dependencies, take an
                        application backup, stop nethelper-backend, swap the
                        trees (the old one is kept as $NETHELPER_HOME.previous),
                        start it (which migrates) and wait until it is healthy.
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# 64 hex characters: URL-safe, since the database password goes into DATABASE_URL.
gen_secret() { od -An -tx1 -N32 /dev/urandom | tr -d ' \n'; }

init_env() {
  template="$NETHELPER_HOME/deploy/systemd/backend.env.example"
  [ -f "$template" ] || die "template not found: $template (set NETHELPER_HOME)"
  [ ! -e "$NETHELPER_ENV" ] || die "$NETHELPER_ENV already exists; edit it instead"

  db_password=$(gen_secret)
  redis_password=$(gen_secret)
  tmp="$NETHELPER_ENV.tmp.$$"
  (umask 077 && DB="$db_password" REDIS="$redis_password" JWT="$(gen_secret)" \
    REFRESH="$(gen_secret)" ENC="$(gen_secret)" awk '
    /^DATABASE_URL=/      { sub(/<hex password>/, ENVIRON["DB"]) }
    /^JWT_SECRET=$/       { $0 = $0 ENVIRON["JWT"] }
    /^JWT_REFRESH_SECRET=$/ { $0 = $0 ENVIRON["REFRESH"] }
    /^ENCRYPTION_KEY=$/   { $0 = $0 ENVIRON["ENC"] }
    /^REDIS_PASSWORD=$/   { $0 = $0 ENVIRON["REDIS"] }
    { print }' "$template" > "$tmp")
  chmod 0640 "$tmp"
  if [ "$(id -u)" -eq 0 ] && getent group "$NETHELPER_USER" >/dev/null 2>&1; then
    chgrp "$NETHELPER_USER" "$tmp"
  fi
  mv "$tmp" "$NETHELPER_ENV"

  cat <<EOF
Wrote $NETHELPER_ENV with generated secrets.

Use these two when setting up the services:
  Database password (ALTER USER nethelper PASSWORD '...'): $db_password
  Redis password (requirepass in /etc/redis/redis.conf):   $redis_password

ENCRYPTION_KEY in that file encrypts every stored credential. Back it up
somewhere other than the database backups.
EOF
}

# Run a backend script as the service user with the settings file loaded.
run_script() {
  script=$1; shift
  [ "$(id -u)" -eq 0 ] || die "run as root (it switches to the $NETHELPER_USER user)"
  [ -r "$NETHELPER_ENV" ] || die "can't read $NETHELPER_ENV (run init-env first?)"
  [ -f "$NETHELPER_HOME/backend/scripts/$script" ] || die "not found: $NETHELPER_HOME/backend/scripts/$script"
  command -v runuser >/dev/null 2>&1 || die "runuser not found (util-linux)"
  node=$(command -v node) || die "node not found"

  # Only these two of the caller's variables are passed on.
  admin_password=${NETHELPER_ADMIN_PASSWORD-}
  admin_password_set=${NETHELPER_ADMIN_PASSWORD+1}
  old_key=${OLD_ENCRYPTION_KEY-}
  old_key_set=${OLD_ENCRYPTION_KEY+1}
  passphrase=${NETHELPER_BACKUP_PASSPHRASE-}
  passphrase_set=${NETHELPER_BACKUP_PASSPHRASE+1}
  unset NETHELPER_ADMIN_PASSWORD OLD_ENCRYPTION_KEY NETHELPER_BACKUP_PASSPHRASE

  set -a
  # shellcheck disable=SC1090 # the settings file is chosen at run time
  . "$NETHELPER_ENV"
  set +a
  export NODE_ENV=production CHECKPOINT_DISABLE=1
  [ -n "$admin_password_set" ] && export NETHELPER_ADMIN_PASSWORD="$admin_password"
  [ -n "$old_key_set" ] && export OLD_ENCRYPTION_KEY="$old_key"
  [ -n "$passphrase_set" ] && export NETHELPER_BACKUP_PASSPHRASE="$passphrase"

  cd "$NETHELPER_HOME/backend"
  exec runuser -u "$NETHELPER_USER" -- "$node" "scripts/$script" "$@"
}

# Restore an application backup with the backend stopped, then start it again.
restore() {
  [ $# -gt 0 ] || die "usage: nethelper-admin restore <archive> [--dry-run] [--yes] [--force]"
  stopped=
  case " $* " in
    *" --dry-run "*|*" --key-out "*|*" --help "*) ;;
    *)
      if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet nethelper-backend; then
        echo "Stopping nethelper-backend for the restore"
        systemctl stop nethelper-backend
        stopped=1
      fi
      ;;
  esac
  status=0
  (run_script app-restore.js --file "$@") || status=$?
  if [ -n "$stopped" ]; then
    echo "Starting nethelper-backend"
    systemctl start nethelper-backend
  fi
  return "$status"
}

# Upgrade a release-tarball install. Run by the release being replaced, so it
# only fetches, prepares, backs up and swaps; the new tree's unit start migrates.
upgrade() {
  version_opt=
  no_backup=
  assume_yes=
  while [ $# -gt 0 ]; do
    case "$1" in
      --version) [ $# -ge 2 ] || die "--version needs a value"; version_opt=$2; shift ;;
      --version=*) version_opt=${1#*=} ;;
      --no-backup) no_backup=1 ;;
      -y|--yes) assume_yes=1 ;;
      *) die "usage: nethelper-admin upgrade [--version VERSION] [--no-backup] [--yes]" ;;
    esac
    shift
  done

  [ "$(id -u)" -eq 0 ] || die "run as root (it replaces $NETHELPER_HOME and restarts the service)"
  lib="$NETHELPER_HOME/deploy/upgrade-lib.sh"
  [ -f "$lib" ] || die "not found: $lib (set NETHELPER_HOME)"
  # shellcheck disable=SC1090 # the tree is chosen at run time
  . "$lib"
  [ ! -e "$NETHELPER_HOME/.git" ] || die "$NETHELPER_HOME is a git checkout, not a release tarball: upgrade it with git pull and the steps in deploy/README.md, \"Upgrading\""
  command -v npm >/dev/null 2>&1 || die "npm not found"
  tree=$(cd "$NETHELPER_HOME" && pwd -P)
  parent=$(dirname "$tree")
  current=$(cat "$tree/VERSION" 2>/dev/null || true)
  [ -n "$current" ] || die "$tree/VERSION is missing: can't tell which version this tree is"
  up_check_previous "$tree"

  work=$(mktemp -d "$parent/.nethelper-upgrade.XXXXXX")
  trap 'rm -rf "$work"' EXIT
  if [ -n "$version_opt" ]; then
    target=${version_opt#v}
    up_check_version "$target"
  else
    target=$(up_latest_version "$work")
  fi
  if [ "$target" = "$current" ]; then
    echo "This install is already NetHelper $current; nothing to do."
    exit 0
  fi
  echo "Installed: $current    New: $target"
  up_fetch_release "$target" "$work"
  new="$work/nethelper-$target"
  up_refuse_downgrade "$tree" "$new"
  migrations=$(up_added_migrations "$tree" "$new")
  [ -f "$new/frontend/dist/index.html" ] || die "nethelper-$target.tar.gz has no prebuilt UI (frontend/dist)"

  # Everything that can fail slowly happens in the new tree, before the running one is touched.
  echo "Installing the backend's dependencies in the new tree (a minute or two)"
  (cd "$new/backend" \
    && NPM_CONFIG_UPDATE_NOTIFIER=false npm ci --omit=dev --no-audit --no-fund \
    && CHECKPOINT_DISABLE=1 npx prisma generate) >"$work/npm.log" 2>&1 \
    || { tail -n 30 "$work/npm.log" >&2; die "couldn't install the new release's dependencies (the end of the log is above); nothing was changed"; }
  if [ -f "$tree/backend/.env" ]; then cp -p "$tree/backend/.env" "$new/backend/.env"; fi
  chown -R "$(stat -c '%u:%g' "$tree")" "$new"

  if [ -z "$assume_yes" ] && [ -t 0 ] && [ -t 1 ]; then
    printf 'Upgrade NetHelper %s to %s now? It will be down for a minute or two. [Y/n] ' "$current" "$target"
    read -r answer || answer=
    case "${answer:-y}" in [Yy]*) ;; *) echo "Stopped; nothing was changed."; exit 0 ;; esac
  fi

  archive=
  if [ -n "$no_backup" ]; then
    echo "Backup skipped (--no-backup)."
  else
    echo "Taking an application backup first, with the settings from Settings -> App Backup."
    if backup_output=$( (run_script app-backup.js) ); then
      archive=$(printf '%s\n' "$backup_output" | sed -n 's/^archive: //p' | tail -n 1)
      echo "Backup written: ${archive:-(name not reported)}"
    else
      die "the backup failed (its error is above), so nothing was changed. Fix it, or run again with --no-backup if you already have a backup."
    fi
  fi

  was_active=
  if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet nethelper-backend; then
    echo "Stopping nethelper-backend"
    systemctl stop nethelper-backend
    was_active=1
  fi
  up_swap_trees "$tree" "$new"
  echo "$tree is now $target; $current is kept at $tree.previous."

  # Files the install copied out of the tree: say which ones this release changed.
  changed=
  for file in deploy/systemd/nethelper-backend.service deploy/nginx/nethelper.conf frontend/nginx/security-headers.conf; do
    cmp -s "$tree.previous/$file" "$tree/$file" 2>/dev/null || changed="$changed $file"
  done

  healthy=1
  if [ -n "$was_active" ]; then
    echo "Starting nethelper-backend (it applies database migrations first)"
    systemctl start nethelper-backend || healthy=
    if [ -n "$healthy" ]; then
      port=$(sed -n 's/^PORT=//p' "$NETHELPER_ENV" 2>/dev/null | tail -n 1)
      bind=$(sed -n 's/^BIND_ADDRESS=//p' "$NETHELPER_ENV" 2>/dev/null | tail -n 1)
      case "$bind" in ''|0.0.0.0) bind=127.0.0.1 ;; esac
      url="http://$bind:${port:-3000}/health/ready"
      echo "Waiting for $url (up to ${NETHELPER_HEALTH_TIMEOUT:-180} seconds)..."
      deadline=$(( $(date +%s) + ${NETHELPER_HEALTH_TIMEOUT:-180} ))
      until up_http_ok "$url"; do
        if [ "$(date +%s)" -ge "$deadline" ]; then healthy=; break; fi
        sleep 3
      done
    fi
  fi
  if [ -z "$healthy" ]; then
    up_rollback_help "$tree" "$current" "$target" "$archive" "$migrations" \
      "systemctl start nethelper-backend" "systemctl stop nethelper-backend"
    echo "The service's log: journalctl -u nethelper-backend -n 50"
    exit 1
  fi

  echo
  echo "Upgraded to NetHelper $target."
  [ -n "$was_active" ] || echo "- nethelper-backend wasn't running, so it wasn't started: systemctl start nethelper-backend"
  echo "- The $current tree is kept at $tree.previous; delete it once you're happy with $target."
  if [ -n "$changed" ]; then
    echo "- This release changed files your install has copies of. Compare and copy what you need"
    echo "  (deploy/README.md, \"Bare metal\"), then reload systemd or nginx:"
    for file in $changed; do echo "    $tree/$file"; done
  fi
  exit 0
}

[ $# -gt 0 ] || { usage >&2; exit 2; }
command=$1; shift
case "$command" in
  init-env) init_env ;;
  users) run_script user-manager.js "$@" ;;
  rotate-key) run_script rotate-encryption-key.js "$@" ;;
  restore) restore "$@" ;;
  upgrade) upgrade "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; die "unknown command: $command" ;;
esac
