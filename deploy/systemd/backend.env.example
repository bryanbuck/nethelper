# NetHelper bare-metal backend settings: copy to /etc/nethelper/backend.env
# (mode 0640, owner root:nethelper). Every other setting has a default; see
# docs/CONFIGURATION.md.
#
# Do NOT add NODE_ENV, BIND_ADDRESS, TRUST_PROXY, LOG_DIR, BACKUP_STORAGE_PATH
# or BACKUP_GIT_REPO_PATH here. The systemd unit sets them, and this file
# overrides the unit (systemd applies EnvironmentFile= after Environment=).
#
# Generate each secret with:   openssl rand -hex 32
# Use hex for the database password: it goes into a URL.

# --- Required ---
DATABASE_URL=postgresql://nethelper:<hex password>@localhost:5432/nethelper?schema=public
JWT_SECRET=
JWT_REFRESH_SECRET=
# Encrypts stored device/cloud/Git credentials. Back it up apart from the
# database: without it the stored credentials can't be decrypted. Changing it
# later requires `npm run key:rotate` (deploy/README.md).
ENCRYPTION_KEY=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PASSWORD=

# --- Optional ---
# Only if the UI is served from a different origin than the API.
#CORS_ORIGINS=
#LOG_LEVEL=info
