# NetHelper Docker Compose settings. ./install.sh copies this to deploy/.env
# and generates the secrets; by hand, copy it and generate each secret with:
#   openssl rand -hex 32
# Use hex (URL-safe) values: POSTGRES_PASSWORD is embedded in a connection URL.

# --- Required secrets ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
# Encrypts stored device/cloud credentials. Back it up apart from the database:
# without it the stored credentials cannot be decrypted. Changing it later
# requires `npm run key:rotate` (see README.md).
ENCRYPTION_KEY=

# --- Optional ---
# Image tag and the version shown in the UI. Leave unset to follow this tree
# (docker-compose.yml's default is bumped with each release); set it only to
# pin a version.
#NETHELPER_VERSION=
# Where release images are pulled from
#NETHELPER_REGISTRY=ghcr.io/bryanbuck
# Where the UI is published on the host
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
# Proxy hops in front of the backend: 1 = the bundled nginx; 2 if you add a
# TLS terminator in front of it
TRUST_PROXY=1
# Only needed if the UI is served from a different origin than the API
CORS_ORIGINS=
LOG_LEVEL=info
PING_MONITOR_ENABLED=true
POSTGRES_DB=nethelper
POSTGRES_USER=nethelper

# --- Host-network override (L2 discovery; see README.md) ---
# Uncomment to use the host-network override. Every docker compose command
# then loads it, including `docker compose run` (e.g. user:manage); without
# this, a command given only docker-compose.yml recreates postgres and redis
# without the ports the host-network backend needs. Setting COMPOSE_FILE also
# stops Compose from loading docker-compose.override.yml on its own, so list
# that too if you have one (e.g. for the Git mirror's SSH key).
#COMPOSE_FILE=docker-compose.yml:docker-compose.host-network.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.host-network.yml:docker-compose.override.yml
