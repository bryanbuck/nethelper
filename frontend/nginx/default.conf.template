# Rendered by the nginx image's envsubst step at container start. Only
# variables defined in the environment (BACKEND_UPSTREAM) are substituted;
# nginx's own $variables are left alone.

upstream nethelper_backend {
    server ${BACKEND_UPSTREAM};
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Matches the backend's default BODY_LIMIT.
    client_max_body_size 2m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Backend probes: /health (liveness) and /health/ready (DB + Redis).
    # Without this the SPA fallback answered them with index.html and a 200.
    location = /health {
        proxy_pass http://nethelper_backend;
    }
    location = /health/ready {
        proxy_pass http://nethelper_backend;
    }

    location /api/ {
        proxy_pass http://nethelper_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Connection tests and backups can take a while on slow devices.
        proxy_read_timeout 300s;
    }

    location /socket.io/ {
        proxy_pass http://nethelper_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }

    # Hashed build assets never change under the same name.
    location /assets/ {
        include /etc/nginx/snippets/nethelper-security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: unknown paths serve index.html; never cache it, so a new release
    # is picked up on the next load.
    location / {
        include /etc/nginx/snippets/nethelper-security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
