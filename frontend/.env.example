# API endpoints. Leave relative so the SPA talks to the same origin it was
# served from (nginx in production, the Vite proxy in development).
VITE_API_URL=/api/v1
# Optional absolute WebSocket URL; defaults to the page's own origin.
VITE_WS_URL=

# Shown in the UI
VITE_APP_VERSION=0.9.0-beta.1

# Verbose client logging. Always on in `npm run dev`; set true to force it on
# in a production build while troubleshooting.
VITE_DEBUG_LOGGING=false
# Optional comma-separated debug categories (see src/utils/debug.js)
VITE_DEBUG_CATEGORIES=

# Authentication
VITE_TOKEN_REFRESH_THRESHOLD=300000
VITE_SESSION_TIMEOUT=3600000

# --- Vite dev server only (no VITE_ prefix: never reaches the bundle) ---
# Backend the dev server proxies /api and /socket.io to
DEV_PROXY_TARGET=http://localhost:3000
# Extra comma-separated hostnames the dev server should answer to
DEV_ALLOWED_HOSTS=
